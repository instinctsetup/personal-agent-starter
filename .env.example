# Copy to .env and fill in what you use. All settings can also be entered in the UI (Setup tab).

# --- login gate (REQUIRED for any cloud deploy; leave empty locally to stay open) ---
APP_PASSWORD=

# --- model (one of these) ---
MODEL_PROVIDER=openai            # openai | gemini | custom
MODEL_API_KEY=
# MODEL_BASE_URL=                # only for a custom OpenAI-compatible endpoint

# --- email (SMTP + IMAP of the same account) ---
EMAIL_USER=
EMAIL_PASS=                      # Gmail: an app password, not your login password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- networking (cloud deploys) ---
# HOST=0.0.0.0                   # set automatically in the Docker image
# PORT=8787
# AGENT_DATA_DIR=/data           # mount a persistent volume here on cloud hosts
