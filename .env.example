# Copy locally to .env. Never commit real secrets.
MODEL_PROVIDER=ollama
MODEL_NAME=llama3.2
MODEL_API_KEY=
# Optional endpoint override. Never use an untrusted proxy with private tasks.
MODEL_BASE_URL=
WORKSPACE_ROOT=./workspace
AGENT_DB=./agent_memory.db
BROWSER_HEADLESS=false
BROWSER_ALLOWED_ORIGINS=https://example.com
# Optional demo login, only used by explicit login_to_site invocation.
SITE_USER=
SITE_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Daemon / bots / embeddings (optional)
# AGENT_POLICY=./policy.json
# BOT_HOOKS=false
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_ALLOWED_CHATS=
# SLACK_SIGNING_SECRET=
# SLACK_TEAM_ID=
# SLACK_ALLOWED_USERS=
# SLACK_ALLOWED_CHANNELS=
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://127.0.0.1:11434
