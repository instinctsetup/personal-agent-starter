{
  "name": "personal-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal agent with a web chat UI: mail, Telegram, job applications and LinkedIn assist.",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "doctor": "node scripts/doctor.mjs",
    "guide": "node scripts/make-guide.mjs",
    "demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "imapflow": "^1.0.181",
    "mailparser": "^3.7.2",
    "nodemailer": "^10.1.7",
    "playwright": "^1.51.0",
    "telegram": "^2.26.22",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
